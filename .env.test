# ══════════════════════════════════════════════════════════════════════════════
# .env.test — Test Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Used by pytest. config.py loads this file when ENVIRONMENT=test.
# Commit this file — test values are not real secrets.
#
# Run tests: ENVIRONMENT=test pytest
# Or set ENVIRONMENT=test in your pytest ini / CI environment.
# ══════════════════════════════════════════════════════════════════════════════

ENVIRONMENT=test
DEBUG=true
LOG_LEVEL=WARNING       # reduce noise during tests
LOG_FORMAT=text

# Unit tests use in-memory SQLite — this URL is only used for integration tests
DATABASE_URL=postgresql+asyncpg://d2c:d2c_secret@localhost:5432/d2c_test_db
DATABASE_SYNC_URL=postgresql+psycopg2://d2c:d2c_secret@localhost:5432/d2c_test_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_PASSWORD=d2c_secret

# Fixed test secrets — predictable values make tests deterministic
JWT_SECRET_KEY=test_jwt_secret_key_fixed_for_deterministic_tests
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fixed Fernet key (must be valid base64-encoded 32 bytes)
ENCRYPTION_KEY=dGVzdF9lbmNyeXB0aW9uX2tleV9mb3JfdGVzdHM=

# Mock integration values
SHOPIFY_MOCK_BASE_URL=http://localhost:8001
SHOPIFY_CLIENT_ID=test_shopify_client_id
SHOPIFY_CLIENT_SECRET=test_shopify_client_secret
SHOPIFY_WEBHOOK_SECRET=test_webhook_secret
META_MOCK_BASE_URL=http://localhost:8002
META_APP_ID=test_meta_app_id
META_APP_SECRET=test_meta_app_secret

GCP_PROJECT_ID=
CLOUD_SQL_INSTANCE=
ALLOWED_ORIGINS=["http://localhost:3000"]

FROM python:3.12-slim

ARG MOCK_MODULE=mock_servers.shopify_mock:mock_shopify
ARG PORT=8001

ENV MOCK_MODULE=${MOCK_MODULE}
ENV PORT=${PORT}

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir fastapi uvicorn httpx pydantic pydantic-settings

COPY mock_servers/ ./mock_servers/
COPY app/ ./app/

EXPOSE ${PORT}

CMD uvicorn ${MOCK_MODULE} --host 0.0.0.0 --port ${PORT}


.env
.env.local
.env.production
.env.staging
.env.*.local

# Allow the template so developers know what variables exist
!.env.example

# GCP service account keys — should NEVER be in a repo
*.json
# But we still want package/config JSON files
!package.json
!package-lock.json
!tsconfig.json

# ── PYTHON ────────────────────────────────────────────────────────────────────
# Bytecode — generated from .py files, platform-specific, never needed in git.
# If committed, every developer's machine regenerates them and git sees noise.
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Distribution / packaging — regenerated by `pip install` or `python setup.py`
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments — machine-specific Python interpreter + packages.
# Every developer runs `python -m venv .venv` locally; committing it breaks
# everyone on a different OS or Python patch version.
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# ── TESTING ───────────────────────────────────────────────────────────────────
# Test output — generated by pytest runs. Not source code.
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py,cover
nosetests.xml
coverage/

# pytest-asyncio generates these
.pytest_asyncio_cache/

# ── TYPE CHECKING ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Local SQLite databases — used in unit tests and local dev experiments.
# These are ephemeral; tests create/destroy them on each run.
*.db
*.sqlite
*.sqlite3

# Alembic generates __pycache__ inside migrations too
migrations/__pycache__/
migrations/versions/__pycache__/

# ── DOCKER ────────────────────────────────────────────────────────────────────
# Docker Compose creates named volumes; these show up as directories if you
# use bind mounts during debugging.
postgres_data/
.docker/

# ── EDITORS & IDEs ────────────────────────────────────────────────────────────
# Editor configs are personal preference. One developer's PyCharm config
# will conflict with another's VS Code config. Use .editorconfig for
# shared formatting rules instead.

# VS Code — workspace-specific launch configs and extensions contain
# absolute paths that only work on your machine
.vscode/
# Allow shared settings that help the whole team
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains (PyCharm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# Vim
*.swp
*.swo
*~
.netrwhist

# Emacs
*#
.#*
\#*#

# macOS — Finder metadata, never relevant to the project
.DS_Store
.DS_Store?
._*
.Spotlight-V8
.Trashes
ehthumbs.db
Thumbs.db
.AppleDouble
.LSOverride
Icon

# Windows
desktop.ini
$RECYCLE.BIN/

# Linux
.directory

# ── LOGS ──────────────────────────────────────────────────────────────────────
# Log files are runtime output, not source. Committing them adds noise and
# can accidentally include sensitive data (request bodies, emails, tokens in
# error messages).
logs/
*.log
*.log.*
pip-log.txt
pip-delete-this-directory.txt

# ── CLOUD / INFRA ─────────────────────────────────────────────────────────────
# Terraform state contains resource IDs and sometimes sensitive values.
# Use remote state (GCS bucket) in production.
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# GCP credential files — should come from `gcloud auth` or a mounted secret,
# never from a file in the repo
gcloud-credentials.json
service-account-key.json
*-keyfile.json

# ── TEMPORARY FILES ───────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
*.rej
.cache/
tmp/
temp/
# ── Copy this to .env and fill in real values ──────────────────────────────
# NEVER commit .env to git

# Database
DATABASE_URL=postgresql+asyncpg://d2c:d2c_secret@localhost:5432/d2c_db
DATABASE_SYNC_URL=postgresql+psycopg2://d2c:d2c_secret@localhost:5432/d2c_db

# Security — generate real keys for production:
#   JWT: python -c "import secrets; print(secrets.token_hex(32))"
#   Encryption: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET_KEY=dev_jwt_secret_change_in_production_256bit_key_here
ENCRYPTION_KEY=dev_encryption_key_change_in_production_here!

# App
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=text

# Integration mock servers (docker-compose internal DNS)
SHOPIFY_MOCK_BASE_URL=http://localhost:8001
META_MOCK_BASE_URL=http://localhost:8002

# Shopify OAuth mock values
SHOPIFY_CLIENT_ID=mock_shopify_client_id
SHOPIFY_CLIENT_SECRET=mock_shopify_client_secret
SHOPIFY_WEBHOOK_SECRET=mock_webhook_hmac_secret

# Meta OAuth mock values
META_APP_ID=mock_meta_app_id
META_APP_SECRET=mock_meta_app_secret

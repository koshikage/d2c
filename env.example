# ══════════════════════════════════════════════════════════════════════════════
# .env.example — D2C Platform
# ══════════════════════════════════════════════════════════════════════════════
#
# USAGE:
#   cp .env.example .env
#   # Edit .env with your local values
#   docker compose up
#
# RULES:
#   - .env is in .gitignore — NEVER commit it
#   - .env.example IS committed — it documents every variable
#   - Every variable here must also exist in Settings (config.py)
#   - Production secrets are NOT in .env — they live in GCP Secret Manager
#
# VARIABLE CATEGORIES:
#   [NON-SECRET]  Safe to put in Cloud Run env vars, docker-compose.yml, CI
#   [SECRET]      Must come from .env locally; from Secret Manager in production
# ══════════════════════════════════════════════════════════════════════════════


# ── App [NON-SECRET] ───────────────────────────────────────────────────────────
# Controls which environment the app thinks it's in.
# development → reads this .env file, text logs, debug mode available
# test        → reads .env.test (or this file), in-memory DB in unit tests
# production  → ignores this file, fetches secrets from GCP Secret Manager
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=text         # "text" for local readability; "json" in production for GCP Logging
APP_NAME=D2C Platform
APP_VERSION=1.0.0


# ── Database [NON-SECRET host/port, SECRET password embedded in URL] ──────────
# Local: the postgres container from docker-compose.yml
# The password here ("d2c_secret") is for local dev only.
# In production, secret_manager.py assembles this URL using the password
# from GCP Secret Manager + the Cloud SQL Unix socket path.
DATABASE_URL=postgresql+asyncpg://d2c:d2c_secret@localhost:5432/d2c_db
DATABASE_SYNC_URL=postgresql+psycopg2://d2c:d2c_secret@localhost:5432/d2c_db

# Connection pool settings
# Set DB_POOL_SIZE=0 in production (Cloud Run) to activate NullPool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20


# ── JWT [SECRET] ──────────────────────────────────────────────────────────────
# Production secret name: d2c-jwt-secret
# Generate a real one: python -c "import secrets; print(secrets.token_hex(32))"
# This local value is intentionally weak — never use this in production.
JWT_SECRET_KEY=dev_jwt_secret_NOT_FOR_PRODUCTION_change_this_locally_too
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60


# ── Encryption Key [SECRET] ───────────────────────────────────────────────────
# Production secret name: d2c-encryption-key
# Used to encrypt OAuth tokens at rest (Fernet AES-128-CBC).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# For key rotation: ENCRYPTION_KEY=new_key,old_key (comma-separated, MultiFernet)
ENCRYPTION_KEY=dev_encryption_key_NOT_FOR_PRODUCTION_change_this_locally_too


# ── Database Password [SECRET] ────────────────────────────────────────────────
# Production secret name: d2c-db-password
# Locally this matches the password in docker-compose.yml (fine for local dev).
# In production, secret_manager.py reads this and assembles DATABASE_URL.
DB_PASSWORD=d2c_secret


# ── Shopify Integration ───────────────────────────────────────────────────────
# client_id [NON-SECRET] — identifies the app, not a credential
# client_secret [SECRET] — production secret name: d2c-shopify-client-secret
# webhook_secret [SECRET] — production secret name: d2c-shopify-webhook-secret

SHOPIFY_MOCK_BASE_URL=http://localhost:8001
SHOPIFY_CLIENT_ID=mock_shopify_client_id
SHOPIFY_CLIENT_SECRET=mock_shopify_client_secret
SHOPIFY_WEBHOOK_SECRET=mock_webhook_hmac_secret


# ── Meta Ads Integration ──────────────────────────────────────────────────────
# app_id [NON-SECRET] — public identifier
# app_secret [SECRET] — production secret name: d2c-meta-app-secret

META_MOCK_BASE_URL=http://localhost:8002
META_APP_ID=mock_meta_app_id
META_APP_SECRET=mock_meta_app_secret


# ── Background Tasks [NON-SECRET] ─────────────────────────────────────────────
SYNC_MAX_RETRIES=3
SYNC_RETRY_BACKOFF_BASE=2.0


# ── CORS [NON-SECRET] ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000"]


# ── GCP Resource Identifiers [NON-SECRET] ────────────────────────────────────
# Leave empty for local development.
# In production (Cloud Run), these are set as plain env vars in
# infra/cloudrun-service.yaml — they identify resources, not credentials.
GCP_PROJECT_ID=
GCP_REGION=us-central1
CLOUD_SQL_INSTANCE=
CLOUD_SQL_DB_USER=d2c_app
CLOUD_SQL_DB_NAME=d2c_db

# Generated by Ansible deploy — do not edit manually
# Source of truth: ansible/vars/vault.uat.yml (encrypted in git)
# To update: ansible-vault edit ansible/vars/vault.uat.yml then redeploy

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/app.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# ── Secrets (filled in by Ansible from vault.uat.yml at deploy time) ─────────
JWT_SECRET_KEY={{ vault_jwt_secret_key }}
ENCRYPTION_KEY={{ vault_encryption_key }}
SHOPIFY_CLIENT_SECRET={{ vault_shopify_client_secret }}
SHOPIFY_WEBHOOK_SECRET={{ vault_shopify_webhook_secret }}
META_APP_SECRET={{ vault_meta_app_secret }}

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://{{ db_user }}:{{ vault_db_password }}@{{ db_container }}:5432/{{ db_name }}
DATABASE_SYNC_URL=postgresql+psycopg2://{{ db_user }}:{{ vault_db_password }}@{{ db_container }}:5432/{{ db_name }}
DB_PASSWORD={{ vault_db_password }}
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── GCP (not used for UAT — secrets come from vault, not Secret Manager) ─────
GCP_PROJECT_ID=
CLOUD_SQL_INSTANCE=

# ── Integration mock servers ──────────────────────────────────────────────────
SHOPIFY_CLIENT_ID=mock_shopify_client_id
SHOPIFY_MOCK_BASE_URL=http://mock-shopify:8001
META_APP_ID=mock_meta_app_id
META_MOCK_BASE_URL=http://mock-meta:8002

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://{{ ansible_host }}","http://{{ ansible_host }}:8000"]